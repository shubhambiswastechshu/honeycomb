# Copy to .env and fill in. Never commit the filled-in file.
#
# Local development runs without any of these — settings.py falls back to
# DEBUG=True and a throwaway SECRET_KEY. Every one of them is REQUIRED in
# production, and Django refuses to boot with DEBUG=False and no SECRET_KEY.

# Django. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Optional. Separate key for signing JWTs so tokens can be rotated (logging
# everyone out) without also invalidating sessions and password-reset links.
# Falls back to DJANGO_SECRET_KEY when unset.
DJANGO_JWT_SIGNING_KEY=

# "False" in production. Controls DEBUG, cookie Secure flags, and HSTS.
DJANGO_DEBUG=True

# Comma separated, no scheme.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Number of trusted reverse proxies in front of Django.
# 0  = read the client IP from REMOTE_ADDR (correct with no proxy)
# 1+ = read it that many hops back in X-Forwarded-For
# Getting this wrong lets an attacker forge X-Forwarded-For and bypass every
# rate limit. Set it to the real number for your deployment.
DJANGO_NUM_PROXIES=0
