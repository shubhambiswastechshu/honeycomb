# Copy to .env and fill in. Never commit the filled-in file.
#
# Local development runs without any of these — settings.py falls back to
# DEBUG=True and a throwaway SECRET_KEY. Every one of them is REQUIRED in
# production, and Django refuses to boot with DEBUG=False and no SECRET_KEY.

# Django. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Optional. Separate key for signing JWTs so tokens can be rotated (logging
# everyone out) without also invalidating sessions and password-reset links.
# Falls back to DJANGO_SECRET_KEY when unset.
DJANGO_JWT_SIGNING_KEY=

# "False" in production. Controls DEBUG, cookie Secure flags, and HSTS.
DJANGO_DEBUG=True

# Comma separated, no scheme.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Number of trusted reverse proxies in front of Django.
# 0  = read the client IP from REMOTE_ADDR (correct with no proxy)
# 1+ = read it that many hops back in X-Forwarded-For
# Getting this wrong lets an attacker forge X-Forwarded-For and bypass every
# rate limit. Set it to the real number for your deployment.
DJANGO_NUM_PROXIES=0

# Database. PostgreSQL is the default engine.
#
# Either set a single URL...
#   DATABASE_URL=postgres://honeycomb:password@localhost:5432/honeycomb
# ...or the discrete variables below. DATABASE_URL wins when both are set.
DJANGO_DB_NAME=honeycomb
DJANGO_DB_USER=honeycomb
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Seconds to keep a connection open between requests. 0 disables reuse.
DJANGO_DB_CONN_MAX_AGE=60

# TLS to the database. Only applied when DJANGO_DEBUG=False. Use "require" at
# minimum; "verify-full" if you have the server's CA available.
DJANGO_DB_SSLMODE=require

# Escape hatch for a throwaway local run with no Postgres installed.
# DJANGO_DB_ENGINE=sqlite

# ---------------------------------------------------------------------------
# SQL console
# ---------------------------------------------------------------------------
#
# Ceilings on a query run. Every one is a limit, not a target -- without them
# an unbounded amount of somebody else's data arrives in this process.
HONEYCOMB_SQL_MAX_ROWS=1000
HONEYCOMB_SQL_TIMEOUT_MS=30000
HONEYCOMB_SQL_MAX_BYTES=4194304
HONEYCOMB_SQL_CONNECT_TIMEOUT=8

# Where a data source's password is looked up.
#
# A DataSource row stores `secret_name` -- a handle -- and never a credential.
# Leave this empty to use the built-in environment backend, which reads
#
#     HONEYCOMB_SECRET_<HANDLE IN UPPER SNAKE CASE>
#
# so a source whose secret name is "warehouse_ro" reads HONEYCOMB_SECRET_WAREHOUSE_RO.
# In production point it at a dotted path to a callable that takes the handle
# and returns the secret (Vault, AWS Secrets Manager, GCP Secret Manager).
HONEYCOMB_SECRET_BACKEND=

# The role each source connects as must be read-only. That privilege -- not
# anything in this codebase -- is what stops a query written in the console
# from deleting a customer's data. Grant SELECT and nothing else.
# HONEYCOMB_SECRET_WAREHOUSE_RO=
#
# On MySQL the grant is not merely the main defence, it is the only one for
# DDL. Verified against MySQL 8.4: START TRANSACTION READ ONLY blocks INSERT,
# UPDATE and DELETE, and does *not* block CREATE, ALTER, TRUNCATE or DROP --
# DDL implicitly commits and sits outside the transaction's read-only mode.
# PostgreSQL refuses DDL in a read-only transaction, so a too-generous role
# there is caught by a second layer that MySQL does not have.
#
#     CREATE USER 'warehouse_ro'@'%' IDENTIFIED BY '...';
#     GRANT SELECT ON analytics.* TO 'warehouse_ro'@'%';

# ---------------------------------------------------------------------------
# MCP portal
# ---------------------------------------------------------------------------
#
# Fernet keys for the connector credentials stored in the `connections` table,
# comma separated, NEWEST FIRST. The first key encrypts; every key can decrypt.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Rotating means PREPENDING the new key and leaving the old one in place until
# every row has been re-saved. Drop a key while rows still depend on it and
# those credentials are gone, not merely unreadable.
#
# Required with DJANGO_DEBUG=False -- Django refuses to boot without it, on the
# same reasoning as DJANGO_SECRET_KEY: no key means every tenant's third-party
# API credentials sit in the database in clear text.
HONEYCOMB_CRED_KEYS=

# The externally reachable origin an AI client will dial. Every MCP URL the
# portal shows is built from it:
#   <base>/mcp/<connector>/<endpoint slug>/
# Those URLs get pasted into Claude or Cursor and stay there, so changing this
# after launch breaks configs that are already in the wild. No trailing slash.
# Defaults to http://localhost:8000 in DEBUG; must be set in production.
HONEYCOMB_PUBLIC_BASE=http://localhost:8000

# Seconds a single MCP tools/call may take before it is abandoned. Generous
# because a connector waiting on a slow third-party API is normal, but it is a
# ceiling: without it one hung upstream holds its slot open indefinitely.
# Whatever runs the process must allow more than this -- see the gunicorn
# --timeout in render.yaml.
HONEYCOMB_MCP_TOOL_TIMEOUT=45

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
#
# Credentials for every Google connector (Analytics, Search Console, Ads and
# the rest). One client serves all of them.
#
# Get them from the Google Cloud Console: APIs & Services > Credentials >
# Create credentials > OAuth client ID, application type "Web application".
# On that same client, under "Authorised redirect URIs", register the callback
# URL verbatim:
#
#   <HONEYCOMB_PUBLIC_BASE>/api/connections/oauth/google/callback/
#
# Google compares that string byte for byte -- scheme, host, port, path and
# trailing slash -- and there is no wildcard. Register http://localhost:8000/...
# for local development and the production origin separately; a mismatch fails
# with redirect_uri_mismatch before the consent screen ever appears.
#
# Leaving these empty is fine, including in production: it only means the
# Google connectors cannot be connected. Every API-key connector still works
# and the service still boots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google's own endpoints. Only worth setting to point a test at a fake.
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth

# Google Ads only. A developer token is issued per Ads manager account and
# approved separately from the Cloud project -- OAuth alone is not enough, the
# API rejects every call without it.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_BASE_URL=https://googleads.googleapis.com

# Pinned deliberately. Google retires an Ads API version roughly yearly and a
# retired version errors rather than degrading, so upgrading is a deliberate
# change somebody tests.
GOOGLE_ADS_API_VERSION=v23

# Where the OAuth callback sends the browser once it is done, with ?connected=1
# or ?error=<message>. This is the FRONTEND's origin -- distinct from
# HONEYCOMB_PUBLIC_BASE above, which is this API's own origin and the one
# registered with Google. In production they are usually different hosts. No
# trailing slash.
HONEYCOMB_FRONTEND_BASE=http://localhost:3000
